.panel {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 300px;
    max-height: 95%; /* cap to viewport; the ScrollView below takes the overflow */
    padding: 10px;
    color: rgb(220, 220, 220);
    background-color: rgba(20, 20, 20, 0.85);
    border-radius: 6px;
}

.scroll {
    flex-grow: 1; /* fill the remaining capped panel height so content scrolls instead of clipping */
}

.panel_title {
    color: rgb(240, 240, 240);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.section {
    margin-bottom: 10px;
}

.section_title {
    color: rgb(200, 200, 200);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.preview {
    width: 256px;
    height: 256px;
    margin-top: 6px;
    background-color: rgb(0, 0, 0);
}

/* Editable inputs (TextField, FloatField, slider numeric box) default to light-on-white -> unreadable on the
   dark panel. Force a dark field so the inherited light text shows. */
.unity-base-field__input {
    background-color: rgb(45, 45, 45);
    border-color: rgb(70, 70, 70);
    color: rgb(230, 230, 230);
}

/* Default runtime buttons are light-gray -> white inherited text is unreadable. Dark button + light text. */
.unity-button {
    background-color: rgb(60, 60, 60);
    border-color: rgb(90, 90, 90);
    color: rgb(230, 230, 230);
}

.unity-button:hover {
    background-color: rgb(78, 78, 78);
}

.unity-button:active {
    background-color: rgb(48, 48, 48);
}

.browse_btn {
    height: 22px;
    margin-top: 2px;
}

.record_btn {
    height: 28px;
    margin-top: 6px;
}

.status {
    margin-top: 4px;
    font-size: 11px;
    color: rgb(180, 180, 180);
    white-space: normal;
}
